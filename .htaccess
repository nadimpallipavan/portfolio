# pavannadimpalli.com: static hosting (Apache / LiteSpeed).
# The site's files live in frontend/, but visitors see them at the root of the domain.
# Order matters: redirects first, then the blocks, then the internal rewrite into frontend/.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. www -> non-www, and always HTTPS, in a single redirect (no chains).
RewriteCond %{HTTP_HOST} ^www\.pavannadimpalli\.com$ [NC]
RewriteRule ^(.*)$ https://pavannadimpalli.com/$1 [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://pavannadimpalli.com/$1 [R=301,L]

# 2. Never serve the backend, dependencies, config or repository files.
RewriteRule ^(backend|node_modules|\.git)(/|$) - [F,L]
RewriteRule ^(package\.json|package-lock\.json|\.env|\.env\.example|\.gitignore|README\.md)$ - [F,L]
RewriteRule (^|/)\.(env|git|gitignore|gitattributes)(/|$|\.) - [F,L]

# 3. A visitor who types or follows /frontend/... gets the clean address without "/frontend".
RewriteCond %{THE_REQUEST} \s/frontend(/[^\s?]*)?(\?[^\s]*)?\s
RewriteRule ^frontend(/(.*))?$ https://pavannadimpalli.com/$2 [R=301,L]

# 4. Everything else is served from frontend/ as the site root, internally (the address bar never changes).
#    "/" becomes frontend/, which loads frontend/index.html through DirectoryIndex.
RewriteCond %{REQUEST_URI} !^/frontend/
RewriteRule ^(.*)$ frontend/$1 [L]
</IfModule>

# Belt and braces: even if a rewrite is skipped, these files are never served directly.
<FilesMatch "^(package\.json|package-lock\.json|\.env|\.env\.example|\.gitignore|README\.md)$">
  Require all denied
</FilesMatch>

# 5. Caching. HTML is never cached; CSS, JS, images and fonts are cached for a year.
#    Every CSS and JS link in index.html ends in ?v=NUMBER, so a changed file gets a new address.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpe?g|webp|gif|svg|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
